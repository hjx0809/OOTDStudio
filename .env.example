# ---- OUL Studio ----
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google AI Studio key (enables Gemini styling + virtual try-on)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_AI_IMAGES=true

# Comma-separated origins for the Vite dev server / deployed frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
# DATABASE_URL=sqlite:////absolute/path/to/oul.db
# UPLOAD_DIR=/absolute/path/to/uploads
